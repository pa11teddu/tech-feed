# Tech Feed environment variables. Copy to .env.local for local runs.
# Never commit real values. See docs/SETUP.md for where each value comes from.

# ── Web app (Vercel + local `npm run dev`) ─────────────────────────────────────
# Supabase → Project Settings → API. The anon key is safe in the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Your email: prefilled on the login screen and inserted into app_owner by `npm run seed`.
OWNER_EMAIL=you@example.com

# ── Pipeline (local `npm run pipeline` + GitHub Actions) ──────────────────────
# Service-role key bypasses RLS. Pipeline only; never expose it to the browser or Vercel.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider: copilot | openai | anthropic   (default: copilot)
#   copilot   = GitHub Copilot CLI (`copilot -p`, all tools disabled), billed to your Copilot plan.
#               Locally it uses your `copilot login`; in Actions set the COPILOT_GITHUB_TOKEN secret
#               (fine-grained PAT with the "Copilot Requests" permission).
#   openai    = any OpenAI-compatible endpoint via fetch (Gemini free tier by default; Groq, OpenRouter...).
#               Replaces GitHub Models, which was retired on 2026-07-30.
#   anthropic = Anthropic API (paid). MAX_RUN_USD applies.
LLM_PROVIDER=copilot
COPILOT_GITHUB_TOKEN=
# Path to the Copilot CLI binary and per-call timeout.
COPILOT_BIN=copilot
COPILOT_TIMEOUT_MS=180000

# Model IDs. Chosen from `copilot help config` (model list) on 2026-11-17:
# claude-haiku-4.5 is the cheapest published Copilot multiplier (0.33 premium requests/call)
# and reliably returns strict JSON. Leave blank to use the per-provider defaults in src/lib/env.ts.
#   copilot:   claude-haiku-4.5 / claude-haiku-4.5   (try claude-sonnet-5.5 for MODEL_WRITE if you have premium requests to spare)
#   openai:    gemini-3.5-flash-lite / gemini-3.5-flash   (Gemini free tier)
#   anthropic: claude-haiku-5-5 / claude-sonnet-5-5
MODEL_CLASSIFY=claude-haiku-4.5
MODEL_WRITE=claude-haiku-4.5

# OpenAI-compatible provider (LLM_PROVIDER=openai)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=

# Anthropic provider (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Embeddings (Phase 2). Must output exactly 1024 dimensions.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
VOYAGE_API_KEY=

# Pipeline tuning
MAX_PER_STREAM_PER_RUN=3
MIN_IMPORTANCE=5
MAX_LLM_CALLS_PER_RUN=40
MAX_RUN_USD=0.50
MAX_INPUT_CHARS=18000
CLUSTER_THRESHOLD=0.82
# Phase 3: comma list of owner/repo for the Dev Tools stream
DEVTOOLS_REPOS=
APP_TIMEZONE=America/Los_Angeles

# Phase 4: Web Push digest
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Removed: GITHUB_MODELS_TOKEN (GitHub Models was retired on 2026-07-30; see docs/SETUP.md).

# ── Dev only ─────────────────────────────────────────────────────────────────
# MOCK_DATA=1 serves fixture posts and skips auth in `next dev` (ignored in production builds).
MOCK_DATA=
